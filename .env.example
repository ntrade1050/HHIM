# Copy to .env and fill in. Never commit .env.

BUSINESS_NAME=H.HIM Chartered Accounting & Tax Services
KNOWLEDGE_DIR=knowledge

# Safety switches
DRY_RUN=true              # true = write replies to the log only. Set false to really send.
AUTO_REPLY=true           # false = send nothing, just forward every enquiry to HANDOFF_EMAIL
MAX_REPLIES_PER_CONTACT_PER_DAY=20
HANDOFF_EMAIL=            # who gets "needs a person" alerts
BOOKING_URL=https://hhim.co.uk/free-consultation/   # swap for the Microsoft Bookings / Calendly page once chosen

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# WhatsApp via Twilio
PUBLIC_BASE_URL=          # e.g. https://abc123.ngrok-free.app  (no trailing slash)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # the sandbox number shown in your Twilio console

# Email: m365 (Microsoft 365), imap (IONOS during migration) or off
EMAIL_PROVIDER=imap
MAILBOX=info@hhim.co.uk
POLL_SECONDS=30

# Microsoft 365 (EMAIL_PROVIDER=m365)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# IONOS (EMAIL_PROVIDER=imap)
IMAP_HOST=imap.ionos.co.uk
IMAP_PORT=993
SMTP_HOST=smtp.ionos.co.uk
SMTP_PORT=465
EMAIL_PASSWORD=
