# Copy to .env and fill in. Never commit .env.

BUSINESS_NAME=H.HIM Chartered Accounting & Tax Services
KNOWLEDGE_DIR=knowledge

# Safety switches
DRY_RUN=true              # true = write replies to the log only. Set false to really send.
AUTO_REPLY=true           # false = send nothing, just forward every enquiry to HANDOFF_EMAIL
MAX_REPLIES_PER_CONTACT_PER_DAY=20
TEST_CHAT=false           # true = open a test chat at http://localhost:8000/chat (local testing only; keep false on a public server)
HANDOFF_EMAIL=            # who gets "needs a person" alerts

# SMS (Twilio): booking confirmations for web bookings, owner alerts, and reminders
SMS_FROM=                 # a Twilio number (+44...) or a one-way sender name like HHIM (max 11 characters)
OWNER_PHONE=              # owner's mobile, gets a text for every booking and every "needs a person" enquiry
REMINDER_HOURS=24         # text clients this many hours before their appointment (0 = off)

# Bookings: clients pick a slot at PUBLIC_BASE_URL/book; client and owner both get a confirmation email with a calendar invite
OWNER_EMAIL=              # gets every booking confirmation (defaults to HANDOFF_EMAIL)
BOOKING_URL=              # leave empty to use PUBLIC_BASE_URL/book
TIMEZONE=Europe/London
BOOKING_DAYS=mon,tue,wed,thu,fri
BOOKING_START=09:30
BOOKING_END=17:00
SLOT_MINUTES=30
BOOKING_DAYS_AHEAD=10

# AI model. Default is Claude. To switch, set LLM_PROVIDER and LLM_API_KEY (and LLM_MODEL if you want another model).
#   deepseek   -> https://api.deepseek.com, default model deepseek-flash (or deepseek-v4-pro)
#   openai     -> https://api.openai.com/v1, default model gpt-4.1-mini
#   openrouter -> https://openrouter.ai/api/v1, LLM_MODEL required
#   openai_compatible -> any other OpenAI-style API: set LLM_BASE_URL and LLM_MODEL
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# WhatsApp via Twilio
PUBLIC_BASE_URL=          # e.g. https://abc123.ngrok-free.app  (no trailing slash)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # the sandbox number shown in your Twilio console

# Email: m365 (Microsoft 365), imap (IONOS during migration) or off
EMAIL_PROVIDER=imap
MAILBOX=info@hhim.co.uk
POLL_SECONDS=30

# Microsoft 365 (EMAIL_PROVIDER=m365)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# IONOS (EMAIL_PROVIDER=imap)
IMAP_HOST=imap.ionos.co.uk
IMAP_PORT=993
SMTP_HOST=smtp.ionos.co.uk
SMTP_PORT=465
EMAIL_PASSWORD=
